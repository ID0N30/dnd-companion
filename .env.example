# ==========================================
# D&D Companion - Environment Variables Template
# ==========================================
# Copy this file to .env.local for local development, or add these 
# environment variables in the Vercel Project Settings dashboard.

# Firebase Web App Credentials (from Firebase Console > Project Settings > General)
# IMPORTANT: NEXT_PUBLIC_FIREBASE_APP_ID must be the Web App ID (1:...:web:...), NEVER a Google Analytics ID (G-...)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
# Firebase Realtime Database URL (for real-time presence, combat, logs, and whispers)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase Emulator Flag (Set to true only when running firebase emulators locally)
NEXT_PUBLIC_USE_EMULATOR=false

# Firebase App Check (reCAPTCHA v3 / Enterprise / Debug Token for anti-bot & quota protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE=false
# NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=your_local_debug_token_for_localhost

# Sentry & Error Telemetry (Optional remote observability for critical errors)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_TELEMETRY_WEBHOOK_URL=https://your-webhook-endpoint.com/api/errors
