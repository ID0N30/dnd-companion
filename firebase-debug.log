[debug] [2026-09-06T17:07:49.146Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    // Colección de Perfiles de Usuario\n    match /users/{userId} {\n      allow read: if isAuthenticated();\n      allow create, update: if isOwner(userId);\n    }\n\n    // Colección de Salas / Campañas\n    match /rooms/{roomId} {\n      // Cualquier persona puede leer información de salas públicas\n      allow read: if true;\n      \n      // Solo usuarios autenticados pueden crear campañas\n      allow create: if isAuthenticated();\n      \n      // Permitir actualización a usuarios autenticados (necesario para avanzar turnos, actualizar estado de combate, etc.)\n      allow update: if isAuthenticated();\n\n      // Solo el DM creador de la sala puede borrar la campaña\n      allow delete: if isAuthenticated() && (\n        resource.data.dmId == request.auth.uid || \n        request.auth.uid == request.resource.data.dmId\n      );\n\n      // Subcolección de Personajes en la Sala\n      match /players/{playerId} {\n        allow read: if true;\n        allow create, update: if isAuthenticated();\n        allow delete: if isAuthenticated() && (\n          resource.data.ownerId == request.auth.uid || \n          resource.data.userId == request.auth.uid || \n          get(/databases/$(database)/documents/rooms/$(roomId)).data.dmId == request.auth.uid\n        );\n      }\n\n      // Subcolección de Logs de Acciones\n      match /logs/{logId} {\n        allow read: if true;\n        allow create: if isAuthenticated();\n      }\n    }\n  }\n}\n"}]}}
