rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regla global para collectionGroup("players") (Lectura en toda la base de datos para recuperación cruzada de personajes)
    match /{path=**}/players/{playerId} {
      allow read: if true;
    }

    // Colección de Perfiles de Usuario
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
    }

    // Colección de Salas / Campañas
    match /rooms/{roomId} {
      // Cualquier persona puede leer información de salas públicas
      allow read: if true;
      
      // Solo usuarios autenticados que sean el DM pueden crear campañas
      allow create: if isAuthenticated() && request.resource.data.dmId == request.auth.uid;
      
      // Solo el DM puede actualizar la campaña, excepto para eventos de turno donde jugadores autenticados solo pueden cambiar currentTurnIndex o lastTurnEvent
      allow update: if isAuthenticated() && (
        resource.data.dmId == request.auth.uid || 
        (request.resource.data.dmId == resource.data.dmId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentTurnIndex', 'lastTurnEvent']))
      );

      // Solo el DM creador de la sala puede borrar la campaña
      allow delete: if isAuthenticated() && resource.data.dmId == request.auth.uid;

      // Subcolección de Personajes en la Sala
      match /players/{playerId} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          request.resource.data.ownerId == request.auth.uid || 
          request.resource.data.dmId == request.auth.uid || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.dmId == request.auth.uid
        );
        allow update: if isAuthenticated() && (
          (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId) || 
          resource.data.dmId == request.auth.uid || 
          (!('ownerId' in resource.data) || resource.data.ownerId == null || resource.data.ownerId == '') || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.dmId == request.auth.uid
        );
        allow delete: if isAuthenticated() && (
          resource == null ||
          !('ownerId' in resource.data) ||
          resource.data.ownerId == null ||
          resource.data.ownerId == '' ||
          resource.data.ownerId == request.auth.uid || 
          resource.data.userId == request.auth.uid || 
          resource.data.dmId == request.auth.uid || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.dmId == request.auth.uid
        );
      }

      // Subcolección de Mensajes Privados / Whispers al DM y Respuestas
      match /whispers/{whisperId} {
        allow read: if isAuthenticated() && (
          resource.data.senderUid == request.auth.uid || 
          resource.data.playerUid == request.auth.uid || 
          resource.data.senderId == request.auth.uid || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.dmId == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          request.resource.data.senderUid == request.auth.uid || 
          request.resource.data.playerUid == request.auth.uid || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.dmId == request.auth.uid
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.senderUid == request.auth.uid || 
          resource.data.playerUid == request.auth.uid || 
          resource.data.senderId == request.auth.uid || 
          get(/databases/$(database)/documents/rooms/$(roomId)).data.dmId == request.auth.uid
        );
      }

      // Subcolección de Logs de Acciones
      match /logs/{logId} {
        allow read: if true;
        allow create: if isAuthenticated();
      }
    }
  }
}
